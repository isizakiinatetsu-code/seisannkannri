# ===== 納入管理システム 環境変数 =====
# このファイルを .env にコピーして値を入れる（.env は絶対に Git に入れない）。
# 値は現在の Vercel の「Settings → Environment Variables」からそのまま写せばOK。

# --- 公開ドメイン（インターネット公開+HTTPS版の docker-compose.yml 用。
#     社内LAN運用(docker-compose.lan.yml)では不要なので空のままでOK） ---
DOMAIN=nouhin.example.co.jp

# --- Cookie の secure 属性（既定 true = HTTPS必須） ---
# 社内LANなどHTTPで運用するとき「だけ」 false にする。
# インターネット公開(HTTPS)運用では設定不要（空 or 未設定＝true）。
COOKIE_SECURE=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ログイン ---
EDIT_PASSWORD=
VIEW_PASSWORD=
SESSION_SECRET=

# --- Google スプレッドシート / ドライブ連携 ---
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
