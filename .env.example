# ===== 納入管理システム 環境変数 =====
# このファイルを .env にコピーして値を入れる（.env は絶対に Git に入れない）。
# 値は現在の Vercel の「Settings → Environment Variables」からそのまま写せばOK。

# --- 公開ドメイン（Docker/Caddy 用。DNS でこのサーバーのIPに向けておく） ---
DOMAIN=nouhin.example.co.jp

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ログイン ---
EDIT_PASSWORD=
VIEW_PASSWORD=
SESSION_SECRET=

# --- Google スプレッドシート / ドライブ連携 ---
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Notion 連携（未設定なら連携しない） ---
# Notion の「インテグレーション」で発行したトークン（ntn_… / secret_…）
NOTION_TOKEN=
# 定期実行（cron）用の合言葉。長いランダム文字列にする
CRON_SECRET=
# 1回の同期で使う時間(ミリ秒)。Docker では 50000 程度まで増やせる
# NOTION_SYNC_BUDGET_MS=8000
# 連携先DBを変える場合のみ（通常は不要）
# NOTION_DS_PROJECTS=
# NOTION_DS_DELIVERIES=
# NOTION_DS_OVERDUE=
# NOTION_DS_ORDERS=
