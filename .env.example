# ===== 納入管理システム 環境変数 =====
# このファイルを .env にコピーして値を入れる（.env は絶対に Git に入れない）。
# 値は現在の Vercel の「Settings → Environment Variables」からそのまま写せばOK。

# --- 公開ドメイン（Docker/Caddy 用。DNS でこのサーバーのIPに向けておく） ---
DOMAIN=nouhin.example.co.jp

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ログイン ---
EDIT_PASSWORD=
VIEW_PASSWORD=
SESSION_SECRET=

# --- Google スプレッドシート / ドライブ連携 ---
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
